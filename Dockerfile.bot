# Optional root-level bot image (build context = repo root).
# Prefer deploying with Root Directory = bot and bot/Dockerfile on Easypanel.
FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

COPY bot/package.json ./
RUN npm install --omit=dev && npm cache clean --force

COPY bot/server.js bot/openrouter.js bot/productEnrichment.js bot/sheetsAppend.js ./

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/health || exit 1

CMD ["node", "server.js"]
