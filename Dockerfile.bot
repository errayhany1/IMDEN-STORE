# Optional root-level bot image (build context = repo root).
# Prefer deploying with Root Directory = bot and bot/Dockerfile on Easypanel.
FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

COPY bot/package.json ./
RUN npm install --omit=dev && npm cache clean --force

COPY bot/server.js bot/openai.js bot/openrouter.js bot/productEnrichment.js bot/sheetsAppend.js bot/amazonScrape.js ./

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=8s --start-period=25s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server.js"]

# rebuild bump 20260724180500 — amazon scrape + photo-only studio AI
LABEL imden.bot.rebuild="20260724180500"
