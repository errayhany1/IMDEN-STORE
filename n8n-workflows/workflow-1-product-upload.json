    {
      "parameters": {
        "functionCode": "const newItems = items.map(item => {\n  const json = item.json;\n  const caption = json.message.caption || \"\";\n\n  // Split lines and clean\n  const lines = caption.split('\\n').map(l => l.trim()).filter(l => l !== '');\n\n  // Line 0 = price\n  let rawPriceLine = lines[0] || \"0\";\n  let priceMatch = rawPriceLine.match(/(\\d+[\\.,]?\\d*)/);\n  let cleanPrice = priceMatch ? parseFloat(priceMatch[0]) : 0;\n\n  // Line 1 = product name\n  let productName = lines[1] || \"منتج غير محدد\";\n\n  // Line 2 = SKU/Ref\n  let productSku = lines[2] || lines[1] || \"غير محدد\";\n\n  // Chat ID for sending the reply\n  const chatId = json.message.chat.id;\n  const messageId = json.message.message_id;\n\n  return {\n    json: {\n      ...json,\n      extracted_price: cleanPrice,\n      extracted_name: productName,\n      extracted_sku: productSku,\n      chat_id: chatId,\n      message_id: messageId\n    }\n  };\n});\n\nreturn newItems;"
      },
      "name": "Parse Caption",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        680,
        300
      ],
      "id": "a1b2c3d4-0003-0003-0003-000000000003"
