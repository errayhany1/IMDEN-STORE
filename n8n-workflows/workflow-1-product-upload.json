    {
      "parameters": {
        "functionCode": "// Build the inline keyboard with all categories\n// Callback data format: cat_CATEGORY_ID_row_ROW_ID\nconst rowId = items[0].json.Id || items[0].json.id;\nconst chatId = $('Parse Caption').item.json.chat_id;\nconst productName = $('Parse Caption').item.json.extracted_name;\nconst productPrice = $('Parse Caption').item.json.extracted_price;\nconst productSku = $('Parse Caption').item.json.extracted_sku;\n\nconst categories = [\n  [1, '🔌 شواحن'], [2, '🎧 سماعات'],\n  [3, '⌚ ساعات ذكية'], [4, '🎮 ألعاب'],\n  [5, '🖱️ ماوس وكيبورد'], [6, '💾 تخزين'],\n  [7, '💻 شواحن حواسيب'], [8, '📐 ستاندات'],\n  [9, '💡 إضاءة'], [10, '📷 كاميرات'],\n  [11, '📡 شبكات'], [13, '🎙️ ميكروفونات'],\n  [14, '🔋 بطاريات وباوربانك'], [12, '📦 عام'],\n  [16, '🔗 كابلات'], [17, '🚗 إكسسوارات السيارة'],\n  [18, '🔌 محولات وHUB'], [19, '📺 أجهزة بث'],\n  [20, '❄️ تبريد'], [21, '📱 هواتف'],\n];\n\nconst inline_keyboard = [];\nfor (let i = 0; i < categories.length; i += 2) {\n  const row = [];\n  for (let j = i; j < i + 2 && j < categories.length; j++) {\n    const [id, text] = categories[j];\n    row.push({ text, callback_data: `cat_${id}_row_${rowId}` });\n  }\n  inline_keyboard.push(row);\n}\n\nreturn [{\n  json: {\n    chat_id: chatId,\n    text: `✅ تم حفظ المنتج رقم #${rowId} بنجاح!\\n\\n📦 الاسم: ${productName}\\n💰 السعر: ${productPrice} DH\\n📋 المرجع: ${productSku}\\n\\n⬇️ اختر التصنيف المناسب للمنتج:`,\n    reply_markup: JSON.stringify({ inline_keyboard })\n  }\n}];"
      },
