      "parameters": {
        "functionCode": "// Parse the callback data: format is 'cat_CATID_row_ROWID'\n// Example: 'cat_1_row_450'\nconst callbackData = items[0].json.callback_query.data;\nconst chatId = items[0].json.callback_query.message.chat.id;\nconst messageId = items[0].json.callback_query.message.message_id;\nconst callbackQueryId = items[0].json.callback_query.id;\n\n// Parse cat and row IDs\nconst parts = callbackData.split('_');\n// parts: ['cat', '1', 'row', '450']\nconst categoryId = parseInt(parts[1]);\nconst rowId = parseInt(parts[3]);\n\n// Map category ID to Arabic name\nconst categoryNames = {\n  1:  '🔌 شواحن',\n  2:  '🎧 سماعات',\n  3:  '⌚ ساعات ذكية',\n  4:  '🎮 ألعاب',\n  5:  '🖱️ ماوس وكيبورد',\n  6:  '💾 تخزين',\n  7:  '💻 شواحن حواسيب',\n  8:  '📐 ستاندات',\n  9:  '💡 إضاءة',\n  10: '📷 كاميرات',\n  11: '📡 شبكات',\n  12: '📦 عام',\n  13: '🎙️ ميكروفونات',\n  14: '🔋 بطاريات وباوربانك',\n  16: '🔗 كابلات',\n  17: '🚗 إكسسوارات السيارة'\n};\n\nconst categoryName = categoryNames[categoryId] || 'عام';\n\nreturn [{\n  json: {\n    category_id: categoryId,\n    category_name: categoryName,\n    row_id: rowId,\n    chat_id: chatId,\n    message_id: messageId,\n    callback_query_id: callbackQueryId\n  }\n}];"
      },
      "name": "Parse Callback Data",
      "type": "n8n-nodes-base.function",
