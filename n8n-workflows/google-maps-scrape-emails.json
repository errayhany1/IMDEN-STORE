        "specifyBody": "json",
        "jsonBody": "{\n  \"language\": \"ar\",\n  \"locationQuery\": \"Casablanca, Morocco\",\n  \"maxCrawledPlacesPerSearch\": 20,\n  \"maxImages\": 0,\n  \"scrapeContacts\": false,\n  \"scrapePlaceDetailPage\": false,\n  \"searchStringsArray\": [\n    \"electronics store\",\n    \"محل هواتف\",\n    \"Computer store\",\n    \"Magasin électronique\"\n  ],\n  \"skipClosedPlaces\": false\n}",
        "options": {
          "timeout": 600000
        }
      },
      "id": "apify-1",
      "name": "Apify Google Maps",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 300],
      "notesInFlow": true,
      "notes": "يركّز على المحلات + المواقع (بدون كشط إيميل). الإيميلات تُستخرج يدوياً من المواقع."
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nfunction normalizeWebsite(url) {\n  if (!url) return '';\n  const u = String(url).trim();\n  if (!u) return '';\n  if (/^https?:\\/\\//i.test(u)) return u;\n  return `http://${u}`;\n}\n\nfunction isSocialOnly(url) {\n  return /facebook\\.com|instagram\\.com|tiktok\\.com|youtube\\.com|twitter\\.com|\\bx\\.com\\b|wa\\.me|whatsapp/i.test(url || '');\n}\n\nlet places = [];\nfor (const item of items) {\n  const raw = item.json;\n  if (Array.isArray(raw)) places.push(...raw);\n  else if (Array.isArray(raw.data)) places.push(...raw.data);\n  else if (raw && typeof raw === 'object') places.push(raw);\n}\n\nreturn places.map((it) => {\n  const website = normalizeWebsite(it.website || '');\n  const facebooks = [].concat(it.facebooks || []).filter(Boolean);\n  const instagrams = [].concat(it.instagrams || []).filter(Boolean);\n  const fb = facebooks[0] || ( /facebook\\.com/i.test(website) ? website : '' );\n  const ig = instagrams[0] || ( /instagram\\.com/i.test(website) ? website : '' );\n  const hasRealWebsite = Boolean(website) && !isSocialOnly(website);\n\n  return {\n    json: {\n      title: it.title || '',\n      phone: it.phoneUnformatted || it.phone || '',\n      city: it.city || '',\n      address: it.address || '',\n      website: hasRealWebsite ? website : '',\n      facebook: fb || '',\n      instagram: ig || '',\n      categoryName: it.categoryName || '',\n      totalScore: it.totalScore ?? '',\n      placeId: it.placeId || '',\n      hasWebsite: hasRealWebsite ? 'yes' : 'no',\n      email: '',\n      emails: ''\n    }\n  };\n}).sort((a, b) => Number(b.json.hasWebsite === 'yes') - Number(a.json.hasWebsite === 'yes'));"
      },
      "id": "normalize-1",
      "name": "Normalize websites",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 300]
    },
