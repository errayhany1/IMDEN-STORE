.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.env

# Local exports (customer CSVs for Brevo, etc.)
tmp/

# Android signing secrets — never commit
android/keystore.properties
*.keystore
*.jks

# Generated at build time and served directly by Easypanel
public/product-images/
public/product-images-manifest.json
public/catalog-cache.json
bot/node_modules/
