# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
dist-desktop
*.local

# Temp Play Console upload shards
play-store/chunks/

# Large desktop installers / APKs — publish via Releases or Easypanel volume
# (kept out of git so EasyPanel GitHub archive downloads do not fail)
public/downloads/*.exe
public/downloads/*.msi
public/downloads/*.AppImage
public/*.apk
public/**/*.apk
*.apk
*.exe

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.env

# Runtime Jumia image cache (served from /bot-api/public-images)
data/jumia-public-images/
bot/data/jumia-public-images/

# Social publish uploads + post history
bot/data/social-media/
bot/data/social-posts.json

# Local pipeline debug renders
bot/data/debug/

# Local exports (customer CSVs for Brevo, etc.)
tmp/

# Android signing secrets — never commit
android/keystore.properties
*.keystore
*.jks

# Generated at build time and served directly by Easypanel
public/product-images/
public/product-images-manifest.json
public/catalog-cache.json
bot/node_modules/

bot/template-previews/

bot/template-previews/
