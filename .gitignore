yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
dist-desktop
*.local

# Temp Play Console upload shards
play-store/chunks/

# Large desktop installers / APKs — publish via Releases or Easypanel volume
