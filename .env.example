# Public frontend configuration
ADMIN_PASSWORD=
# Shared by storefront tracking service and Telegram bot; keep server-side only.
BOT_SETTINGS_ENCRYPTION_KEY=
VITE_NOCODB_URL=
VITE_NOCODB_API_TOKEN=
VITE_NOCODB_ORDERS_TOKEN=
VITE_NOCODB_PROJECT_ID=
VITE_NOCODB_TABLE_PRODUCTS=
VITE_NOCODB_TABLE_ORDERS=
VITE_NOCODB_TABLE_CUSTOMERS=
VITE_NOCODB_TABLE_EXPENSES=

# Bank transfer checkout
VITE_BANK_NAME=
VITE_BANK_ACCOUNT_HOLDER=
VITE_BANK_RIB=
VITE_BANK_IBAN=

# Telegram bot
TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=
OPENROUTER_API_KEY=
VITE_OPENROUTER_API_KEY=
# One direct professional studio generation (original AQ10/AQ3 model).
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# Optional secondary render for every product; shown beside Gemini/cutout/original for approval.
QWEN_API_KEY=
QWEN_IMAGE_MODEL=qwen-image-2.0
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash
# AI_IMAGE_COUNT is intentionally no longer used.
VITE_OPENAI_API_KEY=
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
PRODUCT_AI_ENRICHMENT=true
# Second gallery image: real seller photo segmented locally with U²-Net.
# No paid API and no generative edits. Set false only on very low-memory hosts.
LOCAL_BACKGROUND_REMOVAL=true
# Optional persistent directory; defaults to the OS temp directory (~5 MB model).
BG_REMOVER_MODEL_DIR=
# Optional private mirror for the ONNX model.
BG_REMOVER_MODEL_URL=
# Inference runs in a worker thread; abandon it after this many ms.
LOCAL_BACKGROUND_TIMEOUT_MS=60000
PRODUCT_SHEET_WEBHOOK_URL=
PRODUCT_SHEET_ID=
PUBLIC_SITE_URL=https://errayhany.com
# Telegram Mini App (OPEN button) — must be HTTPS; also set domain in BotFather
TELEGRAM_WEBAPP_URL=https://errayhany.com/admin?from=tg&tab=products

# Tifawt ERP — Lead Source API (orders from website / bot webhook)
# Created in Tifawt → Settings → Lead Sources → Errayhany Website (API)
VITE_TIFAWT_LEAD_URL=https://errayhany.tifawt.ma/api/v1/lead-sources/api/0a4e5144-86c1-4fdf-b276-5b2f5bbcf149
TIFAWT_LEAD_URL=https://errayhany.tifawt.ma/api/v1/lead-sources/api/0a4e5144-86c1-4fdf-b276-5b2f5bbcf149

# Optional: map website refs to existing Tifawt stock SKUs (one per line: SITE=TIFAWT)
# TIFAWT_SKU_ALIASES=MP3 car M53=OLD-MP3-CODE

# Tifawt product sync from Telegram bot (image + name + price + SKU)
# Also required for multi-product website orders (one lead with all lines).
TIFAWT_API_BASE=https://errayhany.tifawt.ma/api/v1
TIFAWT_EMAIL=admin@errayhany.ma
TIFAWT_PASSWORD=
TIFAWT_BUSINESS_ID=1

# Customer order tracking (site → bot server → Tifawt).
# By default the site calls /bot-api/* on its own domain and nginx proxies it
# to the bot service, so no public bot domain is required.
# On the store-app service, point BOT_UPSTREAM at the bot container:
BOT_UPSTREAM=store-app_imden-bot:3000
# Only set this if the bot is hosted on its own public domain instead:
# VITE_TRACKING_API_URL=https://YOUR-BOT-PUBLIC-URL
STOREFRONT_ORIGINS=https://errayhany.com,https://www.errayhany.com,https://imdenmanadger.online,https://www.imdenmanadger.online
FIREBASE_WEB_API_KEY=

# Amazon scrape (Telegram bot) — rotate any leaked token; set on EasyPanel imden-bot then Rebuild
APIFY_TOKEN=
APIFY_AMAZON_ACT=junglee~free-amazon-product-scraper
# APIFY_TIMEOUT_MS=180000
# AI_ENRICH_TIMEOUT_MS=90000
# AI_ENRICH_TIMEOUT_MS_AMAZON=180000

# Inventory is managed in Tifawt ERP only. The website pushes orders
# (sku + quantity + unitPrice) to VITE_TIFAWT_LEAD_URL and does NOT
# decrement NocoDB stock fields.

# Jumia permanent images — served at /bot-api/public-images/p/{sku}/{n}.jpg
# The storefront tracking API must have the same VITE_NOCODB_* vars so it can
# re-fetch fresh signed attachments after a container redeploy (disk cache is optional).
# JUMIA_PUBLIC_IMAGE_BASE=https://errayhany.com/bot-api/public-images
# ProductVariants table: per-color images and stable Jumia color SKUs.
NOCODB_TABLE_PRODUCT_VARIANTS=my006z3z2ataq7u
VITE_NOCODB_TABLE_PRODUCT_VARIANTS=my006z3z2ataq7u
# JUMIA_IMAGE_UPLOAD_SECRET=  # optional; defaults to ADMIN_PASSWORD
