{
  "name": "wholesalecatalog",
  "private": true,
  "version": "2.0.0",
  "description": "Errayhany Store — wholesale electronics catalog for Morocco",
  "author": "Errayhany",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "node generate-seo.mjs && vite build",
    "seo": "node generate-seo.mjs",
    "branding": "node scripts/generate-app-branding.mjs",
    "store:screenshots": "node scripts/generate-store-screenshots.mjs",
    "cap:assets": "npm run branding && npx capacitor-assets generate --android",
    "cap:sync": "npx cap sync android",
    "cap:sync:ios": "npx cap sync ios",
    "android:release": "npm run build && npm run cap:assets && npm run cap:sync",
    "android:aab": "npm run android:release && cd android && gradlew.bat bundleRelease",
    "ios:prepare": "npm run build && npm run branding && npx capacitor-assets generate --ios && npx cap sync ios",
    "desktop": "electron .",
    "desktop:build": "node scripts/make-win-icon.cjs && electron-builder --win",
    "desktop:build:all": "electron-builder --win --mac --linux",
    "desktop:publish-site": "node scripts/copy-desktop-download.cjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "bot": "node bot-server.js",
    "bot:install": "npm install --prefix bot",
    "bot:start": "npm start --prefix bot"
  },
  "build": {
    "appId": "com.imden.store",
    "productName": "Errayhany Store",
    "copyright": "Copyright © Errayhany",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "build"
    },
    "files": [
      "!**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "language": "1025",
      "shortcutName": "Errayhany Store"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "public/app-icon-512.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.shopping",
      "icon": "public/app-icon-512.png"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/vite": "^4.1.18",
    "axios": "^1.15.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase": "^12.12.1",
    "form-data": "^4.0.5",
    "framer-motion": "^12.34.0",
    "jimp": "^1.6.1",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.564.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.1",
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "puppeteer": "^25.0.2",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "wait-on": "^9.0.10"
  }
}
