rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed data model
    // ===============================================================
    // customerAccounts/{uid}
    //   uid: string (required, immutable, Firebase UID)
    //   email: string (required, max 320)
    //   displayName/name: string (required, max 100)
    //   phone/normalizedPhone: string (required, max 30)
    //   address: string (required, max 500)
    //   phoneVerified: bool (required)
    //   cartJson/wishlistJson: string (required, max 200000)
    //   restockJson: string (required, max 100000)
    //   createdAt: timestamp (required, immutable)
    //   updatedAt: timestamp (required, server timestamp)

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function hasValidAccountFields(data) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'name', 'phone',
          'normalizedPhone', 'address', 'phoneVerified',
          'cartJson', 'wishlistJson', 'restockJson',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'name', 'phone',
          'normalizedPhone', 'address', 'phoneVerified',
          'cartJson', 'wishlistJson', 'restockJson',
          'createdAt', 'updatedAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() <= 320
        && data.displayName is string
        && data.displayName.size() <= 100
        && data.name is string
        && data.name.size() <= 100
        && data.phone is string
        && data.phone.size() <= 30
        && data.normalizedPhone is string
        && data.normalizedPhone.size() <= 30
        && data.address is string
        && data.address.size() <= 500
        && data.phoneVerified is bool
        && data.cartJson is string
        && data.cartJson.size() <= 200000
        && data.wishlistJson is string
        && data.wishlistJson.size() <= 200000
        && data.restockJson is string
        && data.restockJson.size() <= 100000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAccountCreate(data) {
      return hasValidAccountFields(data)
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidAccountUpdate(data) {
      return hasValidAccountFields(data)
        && data.uid == resource.data.uid
        && data.createdAt == resource.data.createdAt
        && data.updatedAt == request.time;
    }

    match /customerAccounts/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && isValidAccountCreate(request.resource.data);
      allow update: if isOwner(uid)
        && isValidAccountUpdate(request.resource.data);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
