rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed data model
    // ===============================================================
    // customerAccounts/{uid}
    //   uid: string (required, immutable)
    //   email/displayName/name/phone/normalizedPhone/address: string
    //   phoneVerified: bool
    //   offersOptIn: bool
    //   cartJson/wishlistJson/restockJson: string
    //   createdAt: timestamp (immutable after create)
    //   updatedAt: timestamp
    //
    // offersLeads/{uid}
    //   uid, email, name, phone, source: string
    //   offersOptIn: bool
    //   createdAt / updatedAt: timestamp
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isValidAccount(data) {
      return data.keys().hasOnly([
          'uid', 'email', 'displayName', 'name', 'phone',
          'normalizedPhone', 'address', 'phoneVerified',
          'offersOptIn',
          'cartJson', 'wishlistJson', 'restockJson',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'uid', 'email', 'displayName', 'name', 'phone',
          'normalizedPhone', 'address', 'phoneVerified',
          'offersOptIn',
          'cartJson', 'wishlistJson', 'restockJson',
          'createdAt', 'updatedAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() <= 320
        && data.displayName is string
        && data.displayName.size() <= 100
        && data.name is string
        && data.name.size() <= 100
        && data.phone is string
        && data.phone.size() <= 30
        && data.normalizedPhone is string
        && data.normalizedPhone.size() <= 30
        && data.address is string
        && data.address.size() <= 500
        && data.phoneVerified is bool
        && data.offersOptIn is bool
        && data.cartJson is string
        && data.cartJson.size() <= 200000
        && data.wishlistJson is string
        && data.wishlistJson.size() <= 200000
        && data.restockJson is string
        && data.restockJson.size() <= 100000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOffersLead(data) {
      return data.keys().hasOnly([
          'uid', 'email', 'name', 'phone', 'source',
          'offersOptIn', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'uid', 'email', 'name', 'phone', 'source',
          'offersOptIn', 'createdAt', 'updatedAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() <= 320
        && data.email.size() > 3
        && data.name is string
        && data.name.size() <= 100
        && data.phone is string
        && data.phone.size() <= 30
        && data.source is string
        && data.source.size() <= 40
        && data.offersOptIn is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /customerAccounts/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && isValidAccount(request.resource.data)
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(uid)
        && isValidAccount(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /offersLeads/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && isValidOffersLead(request.resource.data)
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(uid)
        && isValidOffersLead(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // Public product ratings (anonymous visitors + signed-in users).
    // One vote doc per (productKey, voterId); summary docs hold avg/count/sum.
    function isValidRatingSummary(data) {
      return data.keys().hasOnly([
          'productKey', 'ref', 'productId', 'sum', 'count', 'avg', 'updatedAt'
        ])
        && data.keys().hasAll([
          'productKey', 'sum', 'count', 'avg', 'updatedAt'
        ])
        && data.productKey is string
        && data.productKey.size() > 0
        && data.productKey.size() <= 120
        && data.sum is number
        && data.sum >= 0
        && data.sum <= 500000
        && data.count is number
        && data.count >= 0
        && data.count <= 100000
        && data.count == math.round(data.count)
        && data.avg is number
        && data.avg >= 0
        && data.avg <= 5
        && data.updatedAt == request.time
        && (!('ref' in data) || (data.ref is string && data.ref.size() <= 120))
        && (!('productId' in data) || (data.productId is string && data.productId.size() <= 120));
    }

    function isValidRatingVote(data) {
      return data.keys().hasOnly([
          'productKey', 'voterId', 'rating', 'updatedAt'
        ])
        && data.keys().hasAll([
          'productKey', 'voterId', 'rating', 'updatedAt'
        ])
        && data.productKey is string
        && data.productKey.size() > 0
        && data.productKey.size() <= 120
        && data.voterId is string
        && data.voterId.size() > 3
        && data.voterId.size() <= 80
        && data.rating is number
        && data.rating >= 1
        && data.rating <= 5
        && data.rating == math.round(data.rating)
        && data.updatedAt == request.time;
    }

    match /productRatings/{productKey} {
      allow read: if true;
      allow create, update: if isValidRatingSummary(request.resource.data)
        && request.resource.data.productKey == productKey;
      allow delete: if false;
    }

    match /productRatingVotes/{voteId} {
      allow read: if true;
      allow create, update: if isValidRatingVote(request.resource.data)
        && voteId == request.resource.data.productKey + '__' + request.resource.data.voterId;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
